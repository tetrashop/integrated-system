{
  "version": 2,
  "builds": [
    { "src": "gateway/server.js", "use": "@vercel/node" },
    { "src": "frontend/index.html", "use": "@vercel/static" },
    { "src": "frontend/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "gateway/server.js" },
    { "src": "/api/(.*)", "dest": "gateway/server.js" },
    { "src": "/3d/(.*)", "dest": "gateway/server.js" },
    { "src": "/nlp/(.*)", "dest": "gateway/server.js" },
    { "src": "/shop/(.*)", "dest": "gateway/server.js" },
    { "src": "/admin/(.*)", "dest": "gateway/server.js" },
    { "src": "/chess/(.*)", "dest": "gateway/server.js" },
    { "src": "/olympic/(.*)", "dest": "gateway/server.js" },
    { "src": "/ai-manager/(.*)", "dest": "gateway/server.js" },
    { "src": "/probability/(.*)", "dest": "gateway/server.js" },
    { "src": "/(.*)", "dest": "gateway/server.js" }
  ]
}
